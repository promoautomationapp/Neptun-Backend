# Replace database credentials and generate independent secrets before running.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/neptun_broshura
TEST_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/neptun_broshura_test
SESSION_SECRET=replace-with-a-separately-generated-session-secret
UPLOAD_SECRET=replace-with-a-separately-generated-upload-secret
PORT=3000
# Optional bind address. Development defaults to loopback; production to 0.0.0.0.
# HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
STORAGE_DRIVER=local
MAIL_DRIVER=disabled
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
QUEUE_POLL_SECONDS=10
SEED_DEFAULT_PASSWORD=
BOOTSTRAP_SUPPORT_EMAIL=
BOOTSTRAP_ADMIN_EMAIL=

# Production: use private R2 storage and the matching direct database URL.
# STORAGE_DRIVER=r2
# DIRECT_DATABASE_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
