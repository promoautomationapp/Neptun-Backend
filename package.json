{
  "name": "neptun-broshura-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "format": "prettier --write src scripts tests docs",
    "format:check": "prettier --check src scripts tests",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand tests/integration",
    "db:create": "tsx scripts/create-database.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "import:workspace": "tsx scripts/import-workspace.ts",
    "storage:sync-r2": "tsx scripts/sync-r2.ts",
    "backup": "tsx scripts/backup.ts",
    "import:remote-images": "tsx scripts/import-remote-images.ts",
    "benchmark:search": "tsx scripts/benchmark-search.ts",
    "verify:imports": "tsx scripts/verify-imports.ts",
    "verify:restore": "tsx scripts/verify-restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "11.2.7",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.3",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "pg-boss": "10.4.2",
    "pino": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@nestjs/testing": "11.2.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
